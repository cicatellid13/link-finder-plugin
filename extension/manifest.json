{
  "manifest_version": 3,
  "name": "Link Finder",
  "version": "3.0",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "side_panel": {
    "default_path": "panel.html"
  }
}
